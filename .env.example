# =============================================================================
# ローカル単一マシン demo 用（既定 / Wi-Fi不通時のフォールバック）
# 実行: docker compose up -d
# =============================================================================
DATABASE_URL=postgresql+asyncpg://score:score@db:5432/score
REDIS_URL=redis://redis:6379/0
ROTATOR_DATABASE_URL=mysql+aiomysql://rotator:Rotator1!@flagdb:3306/ctf_flags
INGEST_POLL_SECONDS=5
CTFD_URL=http://ctfd:8000
LOG_LEVEL=info
MAX_FLAGS_PER_REQUEST=100

# =============================================================================
# 実インフラ (Proxmox) 用の値（参考）
#   切替は .env ではなく override ファイルで行う:
#     docker compose -f docker-compose.yml -f docker-compose.infra.yml up -d
#   別VMを指すのは ROTATOR_DATABASE_URL だけ。db/redis は同居コンテナなので変更しない。
#   CTFD_URL は CTFd を同じVMで起動する前提で host.docker.internal のまま（override不要）。
# -----------------------------------------------------------------------------
# ROTATOR_DATABASE_URL=mysql+aiomysql://rotator:Rotator1!@192.168.10.4:3306/ctf_flags
# =============================================================================
